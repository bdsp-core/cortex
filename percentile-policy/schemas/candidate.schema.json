{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cortexeeg.org/schemas/percentile-candidate-v1.json",
  "title": "CORTEX candidate posterior input",
  "type": "object",
  "required": ["domains"],
  "properties": {
    "domains": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "enum": ["spike", "sz", "lpd", "gpd", "lrda", "grda", "iic"]
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "required": ["ellSamples"],
            "properties": {
              "ellSamples": {
                "type": "array",
                "minItems": 1,
                "items": {"type": "number"}
              },
              "weights": {
                "type": "array",
                "minItems": 1,
                "items": {"type": "number", "minimum": 0}
              }
            }
          },
          {
            "type": "object",
            "required": ["ellMean", "ellSd"],
            "properties": {
              "ellMean": {"type": "number"},
              "ellSd": {"type": "number", "minimum": 0}
            }
          }
        ]
      }
    }
  }
}

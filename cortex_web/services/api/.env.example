# CORTEX web backend — environment template. Copy to .env (gitignored) or set
# these in your process manager. All are optional in local dev (sane defaults),
# but CORTEX_JWT_SECRET and CORTEX_ADMIN_TOKEN MUST be set in production.

# Secret used to sign session JWTs. If unset, a dev secret is persisted to
# server/.jwt_secret. Set a strong random value in prod (rotating it logs
# everyone out). e.g. `openssl rand -hex 32`
CORTEX_JWT_SECRET=

# Gate for the /api/admin/* endpoints. If unset, the admin API returns 503.
CORTEX_ADMIN_TOKEN=

# Where the SPA fetches the EEG bundle. Local default is /bundle/v1.1-local
# (served by this process). In prod point at the CloudFront/S3 origin, e.g.
# https://dxxxx.cloudfront.net/bundle/v1.1-local
CORTEX_BUNDLE_URL=/bundle/v1.1-local

# Per-session question sample size (the sampler draws this many from the pool).
CORTEX_SESSION_SAMPLE=500

# JWT lifetime in seconds (default 6h).
CORTEX_TOKEN_TTL=21600

# Comma-separated CORS origins allowed to call the API (the SPA's origin in
# prod). Local default covers the Vite dev server + same-origin.
CORTEX_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000

# SQLite path (default services/api/cortex.db).
CORTEX_DB=

# Dev server bind (python -m api.run, from cortex_web/services/).
CORTEX_HOST=127.0.0.1
CORTEX_PORT=8000

# ── Static serving (monorepo / Phase B) ───────────────────────────────────
# In prod, Caddy file-serves the SPA + EEG bundle and uvicorn is a PURE API —
# leave CORTEX_SERVE_STATIC unset. Set it (run_local.sh / ui_smoke / single
# container) to have uvicorn also serve the built SPA + bundle. Dirs default to
# apps/web/{dist,public/bundle}; override for split-deploy / CDN.
CORTEX_SERVE_STATIC=
CORTEX_DIST_DIR=
CORTEX_BUNDLE_DIR=
# Methodology renderers for /api/videos (default: <repo-root>/scripts).
CORTEX_SCRIPTS_DIR=

# ── Email for signup verification + password-reset codes ──────────────────
# Backend: ses | smtp | dev. Auto-detected if unset: smtp when CORTEX_SMTP_HOST
# is set, else ses when CORTEX_EMAIL_FROM + boto3 are present, else a dev stub
# that logs the code to stderr (no real account needed locally).
CORTEX_EMAIL_BACKEND=
# Sender shown on the email (required for ses/smtp).
CORTEX_EMAIL_FROM=CORTEX <no-reply@your-domain>
# SMTP (Gmail/Workspace app password, a Stanford relay, Postmark/SendGrid/Resend…).
# Setting CORTEX_SMTP_HOST selects the smtp backend.
CORTEX_SMTP_HOST=
CORTEX_SMTP_PORT=587
CORTEX_SMTP_USER=
CORTEX_SMTP_PASSWORD=
CORTEX_SMTP_SECURITY=starttls          # starttls (587) | ssl (465) | none
# SES instead of SMTP: set CORTEX_EMAIL_FROM (verified identity) + AWS_REGION,
# and give the process AWS creds (instance role or keys).
AWS_REGION=
# NEVER set in production — dev/CI only; echoes codes in API responses.
# CORTEX_EMAIL_EXPOSE_CODE=1

# CORTEX web backend — environment template. Copy to .env (gitignored) or set
# these in your process manager. All are optional in local dev (sane defaults),
# but CORTEX_JWT_SECRET and CORTEX_ADMIN_TOKEN MUST be set in production.

# Secret used to sign session JWTs. If unset, a dev secret is persisted to
# server/.jwt_secret. Set a strong random value in prod (rotating it logs
# everyone out). e.g. `openssl rand -hex 32`
CORTEX_JWT_SECRET=

# Gate for the /api/admin/* endpoints. If unset, the admin API returns 503.
CORTEX_ADMIN_TOKEN=

# Operational telemetry. Public client-error POSTs are journaled and included
# in a daily digest, never sent as immediate email. Validly authenticated
# application crashes and server 500s retain immediate cooldown-limited alerts.
# CORTEX_OPS_ALERT_TO=
CORTEX_OPS_ALERT_COOLDOWN_S=21600
CORTEX_CLIENT_ERROR_GLOBAL_LIMIT=120
CORTEX_CLIENT_ERROR_FINGERPRINT_LIMIT=20
CORTEX_CLIENT_ERROR_LIMIT_WINDOW_S=3600
CORTEX_CLIENT_ERROR_DIGEST_HOUR_UTC=15
# CORTEX_TELEMETRY_FINGERPRINT_SECRET=
# CORTEX_CLIENT_ERROR_DIGEST_DISABLED=1

# Bundle the server draws sessions from + the SPA fetches EEG blobs under.
# Code default is /bundle/v1.5-k7; the prod value lives in the box's
# /etc/cortex/cortex.env (deploy/.env.example is the source of truth for prod
# values).
CORTEX_BUNDLE_URL=/bundle/v1.5-k7

# Per-session question sample size (the server-side draw). Code default 400;
# the prod value is env-driven from /etc/cortex/cortex.env (provision.sh writes
# 500). Speculative precompute hides the between-question latency, so a larger
# pool is affordable.
CORTEX_SESSION_SAMPLE=400

# ── PrecisionPolicy production rollout ────────────────────────────────────
# `all` is the public default. `email_allowlist` scopes a future canary by
# normalized server-side email; `off` is the immediate new-session AD6
# rollback. The browser cannot request a policy, and in-flight sittings retain
# their persisted policy stamp.
CORTEX_PRECISION_POLICY_ROLLOUT=all
CORTEX_PRECISION_POLICY_EMAILS=elikeldsen@icloud.com
# Frozen Precision was qualified against this complete served bank, not the
# legacy sampled candidate pool.
CORTEX_PRECISION_BUNDLE_URL=/bundle/v1.6-k7-35k

# Browser-compute rollout is independent and OFF by default. It changes only
# execution placement: eligible Precision sessions precompute both binary
# response branches in two helper workers; AD6 always remains serial. The
# browser further requires >=4 reported logical cores and falls back safely.
# Values: off | email_allowlist | all
CORTEX_PRECISION_COMPUTE_ROLLOUT=off
CORTEX_PRECISION_COMPUTE_EMAILS=

# Graded bias-flag reporting (report-only; bias-flag-tiers-v1). `legacy` is
# the default and instant rollback: sittings carry the historical
# interval-clears flags. `all` serves the graded WATCH/EXTREME/
# EXTREME_CONFIRMED tiers + withheld reasons; `email_allowlist` scopes them
# to the listed accounts. In-flight sittings retain their persisted stamp.
# Values: legacy | email_allowlist | all
CORTEX_BIAS_FLAG_TIERS=legacy
CORTEX_BIAS_FLAG_TIERS_EMAILS=

# ── preliminary historical percentile preview ─────────────────────────
# off    = no calculation/stamp (safe default)
# shadow = calculate + persist for validation, never display
# cohort = display only to code/public-id/email allowlist members
# all    = display to every new assessment/training sitting
# cohort/all ALSO require the exact runtime binary hash acknowledgement below.
CORTEX_PERCENTILE_MODE=off
CORTEX_PERCENTILE_ALLOWLIST=
# Current candidate binary SHA-256. Leave blank until the release is reviewed
# and explicitly approved; a mismatch fails closed to no public profile.
CORTEX_PERCENTILE_RELEASE_SHA256=
# Optional path override. Default:
# apps/web/public/norms/historical-calibration-k7-provisional-v1.json
# CORTEX_PERCENTILE_NORM_METADATA=

# JWT lifetime in seconds (default 6h).
CORTEX_TOKEN_TTL=21600

# Comma-separated CORS origins allowed to call the API (the SPA's origin in
# prod). Local default covers the Vite dev server + same-origin.
CORTEX_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000

# ── question-reuse spacing (test↔train exposure exclusion) ─────────────────
# A recently-seen segment isn't re-drawn until BOTH windows clear: within
# CORTEX_SPACING_DAYS days OR the last CORTEX_SPACING_SESSIONS sittings.
CORTEX_SPACING_DAYS=30
CORTEX_SPACING_SESSIONS=3

# ── adaptive-trainer exposure gate (soft, reversible without a redeploy) ───
# all    — every authenticated user (current prod posture)
# cohort — only participants in CORTEX_TRAINING_ALLOWLIST (a pilot cohort)
# off    — nobody (kill-switch: hides the entry + 403s start; in-flight sessions
#          still finalize). Flip in /etc/cortex/cortex.env + restart the service.
CORTEX_TRAINING_MODE=all
# Comma-separated codes / 9-digit public_ids / emails (cohort mode only).
CORTEX_TRAINING_ALLOWLIST=

# ── Sign in with Google (optional) ────────────────────────────────────────
# OAuth Web client id POST /api/auth/google verifies the ID token against.
# Unset → the endpoint 503s and the SPA hides the Google button.
GOOGLE_CLIENT_ID=

# Where /report support submissions are emailed (default elikeldsen@icloud.com).
# CORTEX_REPORT_TO=team@example.org

# Postgres connection-pool ceiling (prod/Postgres only; default 10). Sync
# routes run on Starlette's threadpool, so this bounds concurrent DB work.
# CORTEX_PG_POOL_MAX=10

# SQLite path (default services/api/cortex.db). A postgres:// URL instead
# selects the pooled Postgres backend (prod).
CORTEX_DB=

# Dev server bind (python -m api.run, from cortex_web/services/).
CORTEX_HOST=127.0.0.1
CORTEX_PORT=8000

# ── Static serving (monorepo / Phase B) ───────────────────────────────────
# In prod, Caddy file-serves the SPA + EEG bundle and uvicorn is a PURE API —
# leave CORTEX_SERVE_STATIC unset. Set it (run_local.sh / ui_smoke / single
# container) to have uvicorn also serve the built SPA + bundle. Dirs default to
# apps/web/{dist,public/bundle}; override for split-deploy / CDN.
CORTEX_SERVE_STATIC=
CORTEX_DIST_DIR=
CORTEX_BUNDLE_DIR=
# Methodology renderers for /api/videos (default: <repo-root>/scripts).
CORTEX_SCRIPTS_DIR=

# ── Email for signup verification + password-reset codes ──────────────────
# Backend: ses | smtp | dev. Auto-detected if unset: smtp when CORTEX_SMTP_HOST
# is set, else ses when CORTEX_EMAIL_FROM + boto3 are present, else a dev stub
# that logs the code to stderr (no real account needed locally).
CORTEX_EMAIL_BACKEND=
# Sender shown on the email (required for ses/smtp).
CORTEX_EMAIL_FROM=CORTEX <no-reply@your-domain>
# SMTP (Gmail/Workspace app password, a Stanford relay, Postmark/SendGrid/Resend…).
# Setting CORTEX_SMTP_HOST selects the smtp backend.
CORTEX_SMTP_HOST=
CORTEX_SMTP_PORT=587
CORTEX_SMTP_USER=
CORTEX_SMTP_PASSWORD=
CORTEX_SMTP_SECURITY=starttls          # starttls (587) | ssl (465) | none
# SES instead of SMTP: set CORTEX_EMAIL_FROM (verified identity) + AWS_REGION,
# and give the process AWS creds (instance role or keys).
AWS_REGION=
# NEVER set in production — dev/CI only; echoes codes in API responses.
# CORTEX_EMAIL_EXPOSE_CODE=1

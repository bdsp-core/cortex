# Caddy config for the CORTEX web deploy (cortexeeg.org). Caddy handles TLS
# automatically (Let's Encrypt + HTTP-01). Phase-B serving model:
#   - Caddy FILE-SERVES the SPA (apps/web/dist) + the EEG bundle (apps/web/
#     public/bundle), and reverse-proxies only /api → uvicorn (pure API on :8000).
#   - apex / www / the retired nip.io host all 301 → app.cortexeeg.org.
# provision.sh installs this verbatim (no {{DOMAIN}} substitution — the domain
# is fixed for this deploy).
#
# Caching: versioned bundle blobs are immutable (1y); the bundle manifest gets a
# short cache; the SPA shell + hashed assets are served fresh / by content hash.

app.cortexeeg.org {
    encode gzip zstd

    # API → uvicorn (pure API service; no static served by uvicorn)
    handle /api/* {
        reverse_proxy 127.0.0.1:8000 {
            transport http {
                keepalive 60s
            }
        }
    }

    # EEG bundle (static). Versioned blobs immutable; manifest short-cache.
    handle /bundle/* {
        @bundle_blobs path_regexp bundle_blobs ^/bundle/[^/]+/seg/.+\.(eeg|spec)$
        header @bundle_blobs Cache-Control "public, max-age=31536000, immutable"
        @manifest path_regexp manifest ^/bundle/[^/]+/manifest\.json$
        header @manifest Cache-Control "public, max-age=300"
        root * /opt/cortex/cortex_web/apps/web/public
        file_server
    }

    # SPA (everything else) — single-page app, fall back to index.html.
    handle {
        root * /opt/cortex/cortex_web/apps/web/dist
        try_files {path} /index.html
        file_server
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }
}

# Canonical-domain redirects: apex, www, and the retired nip.io host.
cortexeeg.org, www.cortexeeg.org, cortex-44-233-29-150.nip.io {
    redir https://app.cortexeeg.org{uri} permanent
}

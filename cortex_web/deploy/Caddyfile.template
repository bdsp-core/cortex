# Caddy config for the CORTEX web deploy (cortexeeg.org). Caddy handles TLS
# automatically (Let's Encrypt + HTTP-01). Phase-B serving model:
#   - Caddy FILE-SERVES the SPA (apps/web/dist) + the EEG bundle (apps/web/
#     public/bundle), and reverse-proxies only /api → uvicorn (pure API on :8000).
#   - apex / www / the retired nip.io host all 301 → app.cortexeeg.org.
# provision.sh installs this verbatim (no {{DOMAIN}} substitution — the domain
# is fixed for this deploy).
#
# Caching: versioned bundle blobs are immutable (1y); the bundle manifest gets a
# short cache; the SPA shell + hashed assets are served fresh / by content hash.

app.cortexeeg.org {
    encode gzip zstd

    # API → uvicorn (pure API service; no static served by uvicorn)
    handle /api/* {
        reverse_proxy 127.0.0.1:8000 {
            transport http {
                keepalive 60s
            }
            # Caddy is the edge proxy: overwrite (don't append) X-Forwarded-For
            # with the real TCP peer so a client can't spoof it. The API's
            # per-IP rate limiter keys on the leftmost XFF value; without this
            # an attacker rotates a fake header to get a fresh bucket per
            # request and bypass the brute-force / signup-spam caps.
            header_up X-Forwarded-For {remote_host}
        }
    }

    # EEG bundle (static). Versioned blobs immutable; manifest short-cache.
    handle /bundle/* {
        @bundle_blobs path_regexp bundle_blobs ^/bundle/[^/]+/seg/.+\.(eeg|spec)$
        header @bundle_blobs Cache-Control "public, max-age=31536000, immutable"
        @manifest path_regexp manifest ^/bundle/[^/]+/manifest\.json$
        header @manifest Cache-Control "public, max-age=300"
        root * /opt/cortex/cortex_web/apps/web/public
        file_server
    }

    # SPA (everything else) — single-page app, fall back to index.html.
    handle {
        root * /opt/cortex/cortex_web/apps/web/dist
        try_files {path} /index.html
        file_server
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        # Full resource-level CSP. Verified safe against the actual build
        # (2026-07-02): the bundle has NO eval/Function/wasm; the SMC engine
        # Web Worker is a same-origin asset (worker-src 'self'); the ONLY
        # external origin is Google Identity Services. So scripts are locked to
        # 'self' + the GIS client with NO 'unsafe-inline' (the theme-init
        # script was externalised to /theme-init.js precisely for this). Styles
        # keep 'unsafe-inline': React sets element style="" attributes
        # pervasively and there is one inline <style> theme block — style
        # injection is low-risk, so this is the accepted trade. The GIS
        # allowlist (script/style/connect/frame under accounts.google.com/gsi)
        # is Google's documented CSP for Sign in with Google.
        Content-Security-Policy "default-src 'self'; script-src 'self' https://accounts.google.com/gsi/client; worker-src 'self'; style-src 'self' 'unsafe-inline' https://accounts.google.com/gsi/style; img-src 'self' data:; font-src 'self'; connect-src 'self' https://accounts.google.com/gsi/; frame-src https://accounts.google.com/gsi/; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
        X-Frame-Options "DENY"
        # No camera/mic/geo/etc. anywhere in the app; opt out of FLoC too.
        Permissions-Policy "accelerometer=(), autoplay=(), camera=(), display-capture=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), interest-cohort=()"
        # Cross-window isolation (tabnabbing / cross-origin window refs).
        # -allow-popups keeps any Google OAuth popup fallback working.
        Cross-Origin-Opener-Policy "same-origin-allow-popups"
        -Server
    }
}

# Canonical-domain redirects: apex, www, and the retired nip.io host.
cortexeeg.org, www.cortexeeg.org, cortex-44-233-29-150.nip.io {
    redir https://app.cortexeeg.org{uri} permanent
}

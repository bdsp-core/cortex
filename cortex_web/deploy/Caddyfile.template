# Caddy config for the CORTEX web deploy (cortexeeg.org). Caddy handles TLS
# automatically (Let's Encrypt + HTTP-01). Phase-B serving model:
#   - Caddy FILE-SERVES the SPA (apps/web/dist) + the EEG bundle (apps/web/
#     public/bundle), and reverse-proxies only /api → uvicorn (pure API on :8000).
#   - apex / www / the retired nip.io host all 301 → app.cortexeeg.org.
# provision.sh installs this verbatim (no {{DOMAIN}} substitution — the domain
# is fixed for this deploy).
#
# Caching: versioned bundle blobs are immutable (1y); the bundle manifest gets a
# short cache; hashed SPA assets (/assets/*) are immutable (1y); the SPA shell
# (index.html, theme-init.js) is served fresh so releases roll out instantly.

app.cortexeeg.org {
    encode gzip zstd

    # API → uvicorn (pure API service; no static served by uvicorn).
    # Request-body caps reject oversized uploads at the EDGE (413) before
    # uvicorn allocates — Starlette has no default body limit, so this is the
    # DoS floor. Everything /api is small JSON (4 MB is generous; the largest
    # honest payload is a full result/points blob). header_up: overwrite
    # (don't append) X-Forwarded-For with the real TCP peer so a client can't
    # spoof it — the API's per-IP rate limiter keys on the leftmost XFF value,
    # so without this an attacker rotates a fake header for a fresh bucket per
    # request and bypasses the brute-force / signup-spam caps.
    handle /api/* {
        request_body {
            max_size 4MB
        }
        reverse_proxy 127.0.0.1:8000 {
            transport http {
                keepalive 60s
            }
            header_up X-Forwarded-For {remote_host}
        }
    }

    # EEG bundle (static). Versioned blobs immutable; manifest short-cache.
    handle /bundle/* {
        # Cross-origin blob fetch (app.cortexeeg.org -> bundle.cortexeeg.org via
        # CloudFront): ACAO must be UNCONDITIONAL at the origin so every cached CDN
        # object carries it. CloudFront's cache key omits Origin, so an Origin-
        # conditional ACAO (SimpleCORS alone) got poisoned by no-Origin cache fills
        # -> browser CORS failures on the EEG/spec blobs.
        header Access-Control-Allow-Origin "*"
        @bundle_blobs path_regexp bundle_blobs ^/bundle/[^/]+/seg/.+\.(eeg|spec)$
        header @bundle_blobs Cache-Control "public, max-age=31536000, immutable"
        @manifest path_regexp manifest ^/bundle/[^/]+/manifest\.json$
        header @manifest Cache-Control "public, max-age=300"
        # The bank lives OUTSIDE the app tree (/opt/cortex/bundle) so vite's
        # public/->dist/ copy can never duplicate 11GB of blobs on disk
        # (2026-07-11 disk-pressure fix). /bundle/x maps to /opt/cortex/bundle/x.
        root * /opt/cortex
        file_server
    }

    # Vite's content-hashed assets live in an append-only path outside the
    # active release. Old tabs can therefore lazy-load their coordinator
    # worker/chunks after a deployment instead of receiving the new SPA HTML
    # fallback at an obsolete JavaScript URL.
    handle /assets/* {
        root * /opt/cortex
        header Cache-Control "public, max-age=31536000, immutable"
        file_server {
            precompressed br gzip
        }
    }

    # Immutable, versioned percentile reference runtime. Browser and API also
    # verify its SHA-256 before scoring; this cache rule only avoids repeatedly
    # transferring the 2.7 MB binary between sittings.
    handle /norms/* {
        root * /opt/cortex/cortex_web/apps/web/dist
        header Cache-Control "public, max-age=31536000, immutable"
        file_server {
            precompressed br gzip
        }
    }

    # SPA (everything else) — single-page app, fall back to index.html.
    # index.html, theme-init.js and the logo PNGs are NOT hashed and stay on
    # default revalidation.
    handle {
        root * /opt/cortex/cortex_web/apps/web/dist
        try_files {path} /index.html
        # .br/.gz siblings are written at build time (scripts/precompress.mjs,
        # brotli q11) — served straight off disk, no per-request encode CPU.
        # The site-wide `encode` still covers anything without a sibling.
        file_server {
            precompressed br gzip
        }
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        # Full resource-level CSP. Verified safe against the actual build
        # (2026-07-02): the bundle has NO eval/Function/wasm; the SMC engine
        # Web Worker is a same-origin asset (worker-src 'self'); the external
        # origins are Google Identity Services and the EEG-bundle CDN
        # (bundle.cortexeeg.org → CloudFront → this host's /bundle/*; the SPA
        # fetch()es blobs from whatever bundleUrl the API hands out, so
        # connect-src must allow the CDN host). Scripts are locked to
        # 'self' + the GIS client with NO 'unsafe-inline' (the theme-init
        # script was externalised to /theme-init.js precisely for this). Styles
        # keep 'unsafe-inline': React sets element style="" attributes
        # pervasively and there is one inline <style> theme block — style
        # injection is low-risk, so this is the accepted trade. The GIS
        # allowlist (script/style/connect/frame under accounts.google.com/gsi)
        # is Google's documented CSP for Sign in with Google.
        Content-Security-Policy "default-src 'self'; script-src 'self' https://accounts.google.com/gsi/client; worker-src 'self'; style-src 'self' 'unsafe-inline' https://accounts.google.com/gsi/style; img-src 'self' data:; font-src 'self'; connect-src 'self' https://accounts.google.com/gsi/ https://bundle.cortexeeg.org; frame-src https://accounts.google.com/gsi/; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
        X-Frame-Options "DENY"
        # No camera/mic/geo/etc. anywhere in the app; opt out of FLoC too.
        Permissions-Policy "accelerometer=(), autoplay=(), camera=(), display-capture=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), interest-cohort=()"
        # Cross-window isolation (tabnabbing / cross-origin window refs).
        # -allow-popups keeps any Google OAuth popup fallback working.
        Cross-Origin-Opener-Policy "same-origin-allow-popups"
        -Server
    }
}

# Canonical-domain redirects: apex, www, and the retired nip.io host.
cortexeeg.org, www.cortexeeg.org, cortex-44-233-29-150.nip.io {
    redir https://app.cortexeeg.org{uri} permanent
}

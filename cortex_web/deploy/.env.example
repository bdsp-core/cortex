# Template for /etc/cortex/cortex.env — copy to that path and fill in. Never
# commit the populated file. provision.sh generates one for you.
#
# All values are read by server/app.py + the backup script.

# ── public-facing config ───────────────────────────────────────────
# The full origin participants will reach (https://<your domain>). Caddy
# terminates TLS in front; CORS uses this exact origin.
CORTEX_DOMAIN=cortex.example.org
CORTEX_CORS_ORIGINS=https://cortex.example.org

# Bundle URL the SPA fetches (served by this same instance under /bundle/).
CORTEX_BUNDLE_URL=/bundle/v1.5-k7

# Per-session sampled bundle size — keep at 500 unless the bank is small.
CORTEX_SESSION_SAMPLE=500

# Auth token lifetime in seconds (default 6 h).
CORTEX_TOKEN_TTL=21600

# ── secrets (rotate with care) ─────────────────────────────────────
# 64+ random bytes. Generate once: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
CORTEX_JWT_SECRET=CHANGE_ME_LONG_RANDOM_STRING

# Header value required to call /api/admin/* — keep secret + short-lived.
CORTEX_ADMIN_TOKEN=CHANGE_ME_ANOTHER_RANDOM_STRING

# ── database ───────────────────────────────────────────────────────
# Either a SQLite path (file:/var/lib/cortex/cortex.db) or a postgres URL.
# provision.sh sets this to a local Postgres role it creates for you.
CORTEX_DB=postgresql://cortex:CHANGE_ME_DB_PASSWORD@127.0.0.1:5432/cortex

# ── uvicorn ────────────────────────────────────────────────────────
CORTEX_HOST=127.0.0.1
CORTEX_PORT=8000

# ── Box backup ─────────────────────────────────────────────────────
# rclone remote name (set up via deploy/scripts/rclone-box-setup.md) and the
# folder inside Box that should hold the snapshots + exports.
CORTEX_RCLONE_REMOTE=box
CORTEX_BOX_PATH=CORTEX/backups
# Retention windows (days). Older snapshots are deleted from Box.
CORTEX_BACKUP_RETENTION_DAYS=30

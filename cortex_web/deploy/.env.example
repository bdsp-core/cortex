# Template for /etc/cortex/cortex.env — copy to that path and fill in. Never
# commit the populated file. provision.sh generates one for you.
#
# All values are read by server/app.py + the backup script.

# ── public-facing config ───────────────────────────────────────────
# The full origin participants will reach (https://<your domain>). Caddy
# terminates TLS in front; CORS uses this exact origin.
CORTEX_DOMAIN=cortex.example.org
CORTEX_CORS_ORIGINS=https://cortex.example.org

# Bundle base URL the SPA fetches blobs from. Same-origin form = served by
# this instance under /bundle/; prod uses the CloudFront CDN host instead
# (see deploy/README.md §6): https://bundle.cortexeeg.org/bundle/<version>
CORTEX_BUNDLE_URL=/bundle/v1.5-k7

# Per-session sampled bundle size — keep at 500 unless the bank is small.
CORTEX_SESSION_SAMPLE=500

# Public PrecisionPolicy rollout. `all` applies Precision to every new sitting;
# `email_allowlist` is the canary mode; `off` immediately rolls new sittings
# back to AD6. In-progress sittings retain their stored policy.
CORTEX_PRECISION_POLICY_ROLLOUT=all
CORTEX_PRECISION_POLICY_EMAILS=elikeldsen@icloud.com
CORTEX_PRECISION_BUNDLE_URL=/bundle/v1.6-k7-35k

# Auth token lifetime in seconds (default 6 h).
CORTEX_TOKEN_TTL=21600

# ── secrets (rotate with care) ─────────────────────────────────────
# 64+ random bytes. Generate once: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
CORTEX_JWT_SECRET=CHANGE_ME_LONG_RANDOM_STRING

# Header value required to call /api/admin/* — keep secret + short-lived.
CORTEX_ADMIN_TOKEN=CHANGE_ME_ANOTHER_RANDOM_STRING

# ── email (transactional: verify + password-reset codes) ───────────
# Without these the API falls back to the dev stub (logs codes to stderr,
# sends nothing) and NEW signups can't complete email verification.
# Prod uses the SMTP backend against Amazon SES (see email.py for the full
# backend menu). The SES identity (cortexeeg.org) + production access live in
# the personal AWS account, separate from the EC2 account — SMTP creds bridge
# them, so no instance role is involved. Generate the SMTP user/password from
# an SES-send IAM user (username = its access-key id; password = derived via
# the AWS SES SMTP-credential algorithm for this region).
CORTEX_EMAIL_BACKEND=smtp
CORTEX_SMTP_HOST=email-smtp.us-west-2.amazonaws.com
CORTEX_SMTP_PORT=587
CORTEX_SMTP_SECURITY=starttls
CORTEX_SMTP_USER=CHANGE_ME_SES_SMTP_USERNAME
CORTEX_SMTP_PASSWORD=CHANGE_ME_SES_SMTP_PASSWORD
# No surrounding quotes — systemd EnvironmentFile keeps the value verbatim.
CORTEX_EMAIL_FROM=CORTEX <no-reply@cortexeeg.org>
# Public SPA origin: when set, verify/reset emails include a one-click link
# that lands in the app with the code pre-filled (mailer._one_click_link).
CORTEX_PUBLIC_ORIGIN=https://app.cortexeeg.org

# SES bounce webhook (routers/ses_events.py): SNS posts delivery events to
# POST /api/ses/events?token=<CORTEX_SNS_WEBHOOK_TOKEN>. Unset = endpoint off.
# Mint with `openssl rand -hex 24`; see deploy/README.md "Bounce webhook".
CORTEX_SNS_WEBHOOK_TOKEN=CHANGE_ME_RANDOM_TOKEN
CORTEX_SNS_TOPIC_ARN=arn:aws:sns:us-west-2:394624473373:cortex-ses-events

# ── Sign in with Google (optional) ─────────────────────────────────
# The OAuth Web client ID (audience) that POST /api/auth/google verifies the
# Google ID token against. Same value the SPA builds with (VITE_GOOGLE_CLIENT_ID).
# Public string ending in .apps.googleusercontent.com. If unset, the endpoint
# returns 503 and the Google button is hidden.
GOOGLE_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com

# ── support reports ────────────────────────────────────────────────
# Where /report submissions are emailed (defaults to elikeldsen@icloud.com).
# CORTEX_REPORT_TO=team@example.org

# ── database ───────────────────────────────────────────────────────
# Either a SQLite path (file:/var/lib/cortex/cortex.db) or a postgres URL.
# provision.sh sets this to a local Postgres role it creates for you.
CORTEX_DB=postgresql://cortex:CHANGE_ME_DB_PASSWORD@127.0.0.1:5432/cortex

# ── uvicorn ────────────────────────────────────────────────────────
CORTEX_HOST=127.0.0.1
CORTEX_PORT=8000

# ── Box backup ─────────────────────────────────────────────────────
# rclone remote name (set up via deploy/scripts/rclone-box-setup.md) and the
# folder inside Box that should hold the snapshots + exports.
CORTEX_RCLONE_REMOTE=box
CORTEX_BOX_PATH=CORTEX/backups
# Retention windows (days). Older snapshots are deleted from Box.
CORTEX_BACKUP_RETENTION_DAYS=30

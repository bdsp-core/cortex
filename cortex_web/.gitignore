node_modules/
dist/
*.tsbuildinfo

# Emitted JS from any stray `tsc` build — sources are .ts/.tsx only; vite/
# vitest transpile directly, nothing hand-written is .js in these trees.
engine/**/*.js
src/**/*.js
ui/**/*.js

# Generated data bundle (PHI-adjacent EEG; lives on S3, fetched at runtime).
public/bundle/

# Local env / secrets.
.env
.env.local

# Backend runtime artifacts: SQLite DB + WAL/SHM sidecars, the JWT signing
# secret, exported credentials/results, Python caches. Never commit
# participant credentials or results.
server/*.db
server/*.db-wal
server/*.db-shm
server/.jwt_secret
server/.venv/
**/__pycache__/
*.pyc
codes.csv
results/

.DS_Store

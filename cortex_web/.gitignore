node_modules/
dist/
*.tsbuildinfo
.pytest_cache/
**/.pytest_cache/
.coverage
coverage/
htmlcov/
playwright-report/
test-results/
*.log
*.pid

# Emitted JS from any stray `tsc` build — sources are .ts/.tsx only; vite/
# vitest transpile directly, nothing hand-written is .js in these trees.
apps/web/engine/**/*.js
apps/web/src/**/*.js
apps/web/ui/**/*.js

# Generated data bundle (PHI-adjacent EEG; lives on S3, fetched at runtime).
apps/web/public/bundle/

# Local env / secrets.
.env
.env.local

# Backend runtime artifacts: SQLite DB + WAL/SHM sidecars, the JWT signing
# secret, exported credentials/results, Python caches. Never commit
# participant credentials or results.
services/api/*.db
services/api/*.db-wal
services/api/*.db-shm
services/api/.jwt_secret
# Deploy-time commit stamp (written on the box by deploy_app.sh; read by
# /api/health). Never a repo artifact.
RELEASE
.venv/
**/__pycache__/
*.pyc
codes.csv
results/

.DS_Store

{
  "name": "cortex-web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Browser-based CORTEX adaptive EEG certification test — client-side SMC particle filter in a Web Worker, pixel-identical to the desktop app.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/precompress.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "ui-smoke": "bash scripts/ui_smoke.sh",
    "phone-smoke": "node scripts/phone_smoke.mjs",
    "worker-smoke": "node scripts/worker_smoke.mjs",
    "worker-benchmark": "node scripts/worker_full_bank_benchmark.mjs",
    "visual-smoke": "bash scripts/visual_smoke.sh",
    "visual-smoke:update": "bash scripts/visual_smoke.sh --update"
  },
  "dependencies": {
    "idb": "^8.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.3",
    "pixelmatch": "^6.0.0",
    "playwright": "^1.60.0",
    "pngjs": "^7.0.0",
    "typescript": "^5.5.4",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}

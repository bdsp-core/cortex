.ipynb_checkpoints/
__pycache__/
*.pyc

# LaTeX build artifacts
*.aux
*.log
*.out
*.synctex.gz
*.fdb_latexmk
*.fls
*.toc
*.bbl
*.blg

.DS_Store

# Large experiment outputs — keep summaries/plots, exclude raw per-rep records
results/**/results.jsonl
results/**/run.log
results/run_*.out

# User-managed slide artifacts (not produced by this repo's pipeline)
*.pptx

# PI ingest scripts write timestamped backups
*.bak.*.csv

# --- unified-repo additions ---
.venv/
.pytest_cache/
*.egg-info/
build/
dist/

# Phase-3 calibration staging (regenerable from labels.csv; sha256-pinned
# in calibration/cert_config.yaml v12 provenance). Canonical outputs are
# calibration/ + data/engine_inputs/sdt_fits*.
pipeline/_calib_work/

# Phase 3.5 joint-fit bulky intermediates (regenerable; canonical outputs
# = the s_j table + regenerated sdt_fits + denormalized IIIC CSV, committed
# when produced). Per-task posterior npz + run logs are large/regenerable.
calibration/joint/*_posterior.npz
calibration/joint/logs/

# Phase 7 sub-step 3-A — rater replay bank (regenerable from labels.csv +
# case_bank.csv via `python -m pipeline.replay.build_rater_replay_bank`).
# The bank is ~100 MB gz; the summary is small but kept as a build artifact
# alongside for consistency. Tests skip if absent.
data/replay/rater_replay_bank.csv.gz
data/replay/rater_replay_bank.indexed.pkl
data/replay/rater_replay_summary.csv

# Phase 7 sub-step 3-B/C — deployment + Mode-A replay outputs (regenerable
# from the bank via `python -m deployment.replay.run_deployment_replay`).
# Per-task CSV is small (~2-3 MB at the full 14,823-cell cohort); per-
# candidate CSV is ~21 rows; summary JSON ~1 KB. Kept gitignored as build
# artifacts alongside the bank to keep the regenerate-from-source pipeline
# clean.
results/replay/
results/replay_mode_a/

# Phase 7 sub-step 4 — Paper-1 figure regeneration outputs (regenerable
# from `python scripts/run_phase1_experiments_v2.py` +
# `python scripts/plot_phase1_figure.py`, and Tier-2 OC via
# `python scripts/run_tier2_oc_simstudy.py --k-grid 7 --n-reps 1` +
# `python scripts/run_phase4_figures.py`). Same precedent as sub-7.3:
# regenerate-from-source rather than commit large build artifacts.
results/phase1_figures/
results/phase2_validation/

# Phase 8 sub-step 4 — `ilae-paper` Mode-A bridge smoke outputs.
# Regenerable via `ilae-paper --max-raters N --method ... --n-reps M`.
results/mode_a_auroc/

# D9: PHI-bearing EEG must NEVER be committed (data/SENSITIVE.md §"D9").
# eeg_bank.h5 is the spike-paper item-bank HDF5; in this repo it appears
# as a local working file for scripts/eeg_bank_viewer.py and must stay
# external. Defensive ignore so `git add data/` cannot accidentally
# stage it. Canonical EEG source remains sibling-repo as documented.
data/eeg_bank.h5
# Backup of v1 bank kept locally during v1.1.0 transition (D9: same PHI).
data/eeg_bank_v1_backup.h5
data/eeg_bank_v2.h5
# 300-seg build-data-v2 bank pulled locally for the web bundle (gh release /
# s3 eeg-test). Same PHI-adjacent EEG payload — never commit.
data/eeg_bank_v2_300.h5
# Phase-9 K=7 legacy backup of the v1.1.0 K=6 bank (D9: same PHI).
data/eeg_bank_v1.1.0_legacy.h5
# eeg_bank_spec.h5: full unified spec bank (~107 GB local; PHI-bearing
# raw EEG arrays). Sourced from AWS s3://bdsp-... per data/SENSITIVE.md.
# Defensive ignore — must NEVER be committed under any circumstances.
data/eeg_bank_spec.h5
# SN1_combined_v2.h5: external PHI-bearing spike-corpus EEG (D9).
# Per data/SENSITIVE.md: stays external; never vendored.
data/SN1_combined_v2.h5

# Phase-9 Layer-6b offline-fallback bundle (1.2 GB; D9: PHI EEG signals
# from SN1 + IIIC corpus). Generated by
# scripts/build_cortex_bank_k7_production.py --mode fallback. The bundle
# is staged into the CORTEX PyInstaller installer at build time, not
# tracked in source. Ships as a separate cohort-test-bank GitHub-release
# asset alongside the installer.
cortex_app/cortex_offline_fallback.h5
cortex_app/cortex_offline_fallback.manifest.json

# Phase-9 Layer-6b production-bank build outputs (full 38K segs ~ 43 GB
# when generated). Same D9 PHI rules apply — these never go to git.
data/production_bank/

# sim_v1_2_0/ — temporary AD6 ship-config calibration sims (2026-05-29).
# Selected the v1.2.0 DEFAULT_N_MIN and DEFAULT_ALPHA values; final report
# preserved as docs/SIM_V1_2_0_REPORT.md. Code + CSV outputs are
# regenerable from running sim_v1_2_0/run_*.py. Delete the directories
# locally once v1.2.0 ships: `rm -rf sim_v1_2_0/ results/sim_v1_2_0/`.
sim_v1_2_0/
results/sim_v1_2_0/

# IIIC test-set working dir (336 MB local; canonical bundle lives at
# s3://bdsp-opendata-credentialed/eeg-test/test_h5.h5). The PHI-stripped
# in-repo variant is data/test_h5_mini/ (9 MB).
data/test_h5/

# JSON variant of data/iiic_precompute_manifest.csv (redundant 70 MB).
data/iiic_precompute_manifest.json

# --- CORTEX internal test ---
# cortex_config.yaml carries a live Dropbox access token — NEVER commit it.
# The token-free template cortex_config.example.yaml is tracked instead.
# (The distributed zip includes the real cortex_config.yaml by design.)
cortex_config.yaml
# Per-session test-taker results — PHI (names, emails, responses).
results/sessions/
results/registrations.csv
# Local copies of crash-dump diagnostic JSONs (also uploaded to Dropbox
# /debugging-incidents/). Dev runs leave them under results/diagnostics/;
# frozen bundles use user_data_root()/diagnostics/ — both are local-only.
results/diagnostics/
# Ad-hoc / manually-copied session artifacts also carry PHI — never commit.
first-test-csv-results/

# --- Claude Code per-project metadata (not project artifacts) ---
.claude/

# v1.3.6: paper drafts (cover letter / prereg / firewall) stay OUT of the
# public repo; local bank backups are too large + redundant for git.
paper/
data/eeg_bank_pre_*.h5

# NEJM AI Paper-2 simulation suite (design + throwaway sim infra; never vendored)
paper_sims/

.ipynb_checkpoints/
__pycache__/
*.pyc

# LaTeX build artifacts
*.aux
*.log
*.out
*.synctex.gz
*.fdb_latexmk
*.fls
*.toc
*.bbl
*.blg

.DS_Store

# Large experiment outputs — keep summaries/plots, exclude raw per-rep records
results/**/results.jsonl
results/**/run.log
results/run_*.out

# User-managed slide artifacts (not produced by this repo's pipeline)
*.pptx

# PI ingest scripts write timestamped backups
*.bak.*.csv

# --- unified-repo additions ---
.venv/
.pytest_cache/
*.egg-info/
build/
dist/

# Phase-3 calibration staging (regenerable from labels.csv; sha256-pinned
# in calibration/cert_config.yaml v12 provenance). Canonical outputs are
# calibration/ + data/engine_inputs/sdt_fits*.
pipeline/_calib_work/

# Phase 3.5 joint-fit bulky intermediates (regenerable; canonical outputs
# = the s_j table + regenerated sdt_fits + denormalized IIIC CSV, committed
# when produced). Per-task posterior npz + run logs are large/regenerable.
calibration/joint/*_posterior.npz
calibration/joint/logs/

# Phase 7 sub-step 3-A — rater replay bank (regenerable from labels.csv +
# case_bank.csv via `python -m pipeline.replay.build_rater_replay_bank`).
# The bank is ~100 MB gz; the summary is small but kept as a build artifact
# alongside for consistency. Tests skip if absent.
data/replay/rater_replay_bank.csv.gz
data/replay/rater_replay_bank.indexed.pkl
data/replay/rater_replay_summary.csv

# Phase 7 sub-step 3-B/C — deployment + Mode-A replay outputs (regenerable
# from the bank via `python -m deployment.replay.run_deployment_replay`).
# Per-task CSV is small (~2-3 MB at the full 14,823-cell cohort); per-
# candidate CSV is ~21 rows; summary JSON ~1 KB. Kept gitignored as build
# artifacts alongside the bank to keep the regenerate-from-source pipeline
# clean.
results/replay/
results/replay_mode_a/

# Phase 7 sub-step 4 — Paper-1 figure regeneration outputs (regenerable
# from `python scripts/run_phase1_experiments_v2.py` +
# `python scripts/plot_phase1_figure.py`, and Tier-2 OC via
# `python scripts/run_tier2_oc_simstudy.py --k-grid 7 --n-reps 1` +
# `python scripts/run_phase4_figures.py`). Same precedent as sub-7.3:
# regenerate-from-source rather than commit large build artifacts.
results/phase1_figures/
results/phase2_validation/
